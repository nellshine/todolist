-- =========================================================
-- 마이그레이션 후보 (미적용): 002_add_todos_start_date_index_candidate
-- =========================================================
-- 상태: 비활성 (파일 확장자가 .sql.disabled 이므로 backend/src/migrations/run.js가
--       *.sql 패턴으로 자동 실행하는 대상에 포함되지 않는다)
--
-- 적용 조건 (중요):
--   이 마이그레이션은 DB-6 EXPLAIN ANALYZE 벤치마크 결과, 아래 문제의식이
--   실제로 확인되고 성능 영향이 유의미할 때에만 적용한다.
--   적용하기로 결정한 경우, 사람이 직접 판단한 후 파일명에서 `.disabled`를
--   제거하여 `002_add_todos_start_date_index_candidate.sql`로 만들고
--   `node backend/src/migrations/run.js`로 실행한다.
--   벤치마크 결과 커버리지 부족이 확인되지 않거나 성능 영향이 미미하다면
--   이 파일은 적용하지 않고 그대로 둔다(불필요한 인덱스는 쓰기 성능과
--   저장 공간에 비용을 유발하므로 신중히 판단할 것).
--
-- 문제의식:
--   기존 복합 인덱스 idx_todos_owner_completed_end_date(owner_id, is_completed, end_date)는
--   "완료 여부 + 종료일자" 기준 필터/정렬(예: 완료된 할일, 기한초과 할일 조회)에는
--   유효하지만, start_date를 포함하지 않는다.
--   목록 조회(FR-8) 화면에서 "시작 전(start_date > 오늘)" 또는 "진행중
--   (start_date <= 오늘 <= end_date)" 상태 필터링처럼 start_date를 조건으로
--   사용하는 조회 패턴에서는 이 인덱스만으로 충분한 커버리지를 제공하지
--   못하고, Seq Scan으로 폴백할 가능성이 있다.
--   본 후보 인덱스는 owner_id + is_completed + start_date 조합으로
--   해당 조회 패턴을 인덱스 스캔으로 처리할 수 있도록 보완하기 위한 것이다.
--
-- 대상 버전: PostgreSQL 17
-- =========================================================

CREATE INDEX IF NOT EXISTS idx_todos_owner_completed_start_date
    ON todos (owner_id, is_completed, start_date);
